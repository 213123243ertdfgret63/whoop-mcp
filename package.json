{
  "name": "whoop-mcp",
  "version": "0.6.1",
  "description": "MCP server for the WHOOP Developer API (v2), built for Bun",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "spec:update": "bun run scripts/update-spec.ts",
    "gen:types": "bunx openapi-typescript@7.13.0 openapi/whoop.yaml -o src/whoop/openapi.d.ts",
    "inspect": "bunx @modelcontextprotocol/inspector bun run src/index.ts",
    "build": "bun build src/index.ts --compile --minify --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile dist/whoop-mcp",
    "release": "bun run scripts/release.ts",
    "prepare": "husky && bun run gen:types",
    "build:mcpb": "bun run scripts/build-mcpb.ts"
  },
  "overrides": {
    "zod": "^4.2.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@biomejs/biome": "2.6.3",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/bun": "^1.4.4",
    "husky": "9.1.7",
    "typescript": "^7.0.2"
  }
}
